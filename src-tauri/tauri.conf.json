{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typst-pad",
  "version": "0.10.1",
  "identifier": "com.typst.pad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Typst-pad",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "fonts": "fonts/"
    },
    "fileAssociations": [
      {
        "ext": ["typ"],
        "name": "Typst-pad.typ",
        "description": "Typst Source File",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Z3O1/Typst-pad/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1N0IzNDcxRERDMDc5NEUKUldST2VjRGRjVFI3dGExQlRRRk9rQUw2bFFMelVUUFExa0poeTFIMUZDRlFLSk1qNEVVcVdJN2IK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
