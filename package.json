{
  "name": "typst-pad",
  "version": "0.7.6",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "fixtures:math": "mkdir -p .browser-check && cargo test --manifest-path src-tauri/Cargo.toml dump_math_fixtures -- --ignored --nocapture 2>/dev/null | grep '^FIXTURE:' | sed 's/^FIXTURE://' | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>require('fs').writeFileSync('.browser-check/math-fixtures.json',JSON.stringify(s.split('\\n').filter(Boolean).map(JSON.parse),null,1)))\""
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-typst": "^0.4.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "jsdom": "^30.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@swc/core@1.15.47": true,
    "esbuild@0.25.12": true
  }
}
